{
  "name": "cong-le-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-blog.mjs && node scripts/generate-sitemap.mjs",
  "build": "vite build && vite build --ssr entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/inject-analytics.mjs",
    "preview": "vite preview",
    "sync": "node scripts/sync-apps.mjs",
    "blog:build": "node scripts/build-blog.mjs",
    "blog:publish": "node scripts/publish-next.mjs",
    "content:check": "node scripts/content-check.mjs",
    "test:publisher": "node --test tests/publish-next.test.mjs",
    "links:check": "node scripts/augment-android-landing-pages.mjs --check && node scripts/validate-public-links.mjs",
    "indexnow:sitemap": "node scripts/submit-sitemap-indexnow.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "marked": "^18.0.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
